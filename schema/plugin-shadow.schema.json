{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eval-magic.dev/schema/plugin-shadow.schema.json",
  "title": "Plugin shadow report",
  "description": "Versioned provenance for live and staged skill sources that can affect an eval comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_dir",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "config_dir": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "isolates_live_sources": {
      "type": "boolean"
    },
    "verification": {
      "$ref": "#/$defs/report_verification"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "skill_name",
        "role",
        "severity",
        "sources"
      ],
      "properties": {
        "class": {
          "enum": [
            "operator-environment",
            "codebase-sourced"
          ],
          "description": "Whether the non-staged source comes from the operator environment or from the sourced task codebase."
        },
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "subject",
            "sibling"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "comparison-invalid"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "resolved_severity": {
          "enum": [
            "isolated",
            "warning",
            "comparison-invalid"
          ],
          "description": "Severity after dispatch transcripts are applied. Absent means the finding was never verified, which differs from being verified and found harmless (`isolated`). The sibling `severity` field stays intrinsic and is never rewritten."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "origin",
        "skill_name",
        "runtime_id",
        "discovery_path",
        "root"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "plugin"
          ]
        },
        "origin": {
          "enum": [
            "live",
            "staged"
          ]
        },
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "discovery_path": {
          "type": "string",
          "minLength": 1
        },
        "canonical_path": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "appearances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/appearance"
          }
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "$ref": "#/$defs/source_verification"
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "namespace",
        "path",
        "relation"
      ],
      "properties": {
        "scope": {
          "enum": [
            "project",
            "global",
            "admin",
            "unknown"
          ]
        },
        "namespace": {
          "enum": [
            "opencode",
            "claude",
            "cline",
            "agents",
            "codex",
            "plugin",
            "unknown"
          ]
        },
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "native",
            "cross-harness",
            "unknown"
          ]
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "condition",
        "eval_ids",
        "resolution"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "eval_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution": {
          "enum": [
            "selected",
            "shadowed",
            "coexisting",
            "unknown"
          ]
        },
        "precedence_rank": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cells"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/verification_status"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell_verification"
          }
        }
      }
    },
    "cell_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "condition",
        "status",
        "dispatches_with_evidence",
        "dispatches_without_evidence"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/verification_status"
        },
        "dispatches_with_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "dispatches_without_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification_status": {
      "enum": [
        "confirmed",
        "refuted",
        "unverified"
      ],
      "description": "`refuted` requires every expected cell to have reported and none to have seen the source; a missing transcript yields `unverified`, never `refuted`."
    },
    "report_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "harness_reports_session_surface",
        "dispatches_with_evidence",
        "dispatches_without_evidence",
        "refuted_findings",
        "confirmed_findings",
        "unverified_findings",
        "assertion_contradicted"
      ],
      "properties": {
        "generated": {
          "type": "string"
        },
        "harness_reports_session_surface": {
          "type": "boolean"
        },
        "dispatches_with_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "dispatches_without_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "refuted_findings": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_findings": {
          "type": "integer",
          "minimum": 0
        },
        "unverified_findings": {
          "type": "integer",
          "minimum": 0
        },
        "assertion_contradicted": {
          "type": "boolean",
          "description": "A descriptor declared `isolates_live_sources = true` while evidence shows a reported source loaded anyway."
        }
      }
    }
  }
}
